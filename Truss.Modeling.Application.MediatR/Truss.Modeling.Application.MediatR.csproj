<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">netstandard2.0;net461;</TargetFrameworks>
        <TargetFramework Condition="'$(OS)' != 'Windows_NT'">netstandard2.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
        <DefineConstants>$(DefineConstants);NETFRAMEWORK</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[2.0.0, 5)" />
        <PackageReference Include="MediatR" Version="[9, 12)" />
        <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="[7, 12)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[6.0.0, 10)" />
        <PackageReference Include="MediatR" Version="[12.0.1, 13)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Truss.Modeling.Application\Truss.Modeling.Application.csproj" />
        <ProjectReference Include="..\Truss.Modeling.Domain\Truss.Modeling.Domain.csproj" />
    </ItemGroup>
</Project>
