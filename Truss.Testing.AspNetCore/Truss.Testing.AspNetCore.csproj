<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Version>0.0.1-alpha-2</Version>
        <Title>Truss.Testing.Dsl.AspNetCore</Title>
        <Description>Support for testing AspNetCore web servers</Description>
        <TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

   <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[6.0.0,)" />
      <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="6.0.26" />
    </ItemGroup>

</Project>
